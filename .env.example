APP_NAME="DSSC Alumni Tracking & Job Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila
APP_SCHEDULE_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alumni_portal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=queued_jobs
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@alumniportal.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SCOUT_DRIVER=tntsearch
SCOUT_PREFIX=
SCOUT_QUEUE=false
TNTSEARCH_FUZZINESS=true
TNTSEARCH_BOOLEAN=true
TNTSEARCH_MAX_DOCS=500

PORTAL_BRAND_NAME="DSSC Alumni Tracking & Job Portal"
PORTAL_BRAND_SHORT_NAME="DSSC Alumni Portal"
PORTAL_SCHOOL_NAME="Davao del Sur State College"
PORTAL_LOGO=/uikit/assets/images/dssc-logo-circle.png
PORTAL_PER_PAGE=20
MATCHING_MINIMUM_SCORE=45
EXPORT_QUEUE_THRESHOLD=200
EXPORT_DISK=public
EXPORT_PATH=exports
NOTIFICATION_ARCHIVE_DAYS=30
WEEKLY_SUMMARY_EMAIL=admin@alumniportal.com

BACKUP_DISK=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=admin@alumniportal.com
